# ---------------------------------------------------------------------------
# Artisan's Corner - example environment file
# Copy to server/.env (backend) and client/.env (frontend, VITE_* keys only).
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# ---------- SERVER ----------
NODE_ENV=development
PORT=5055

# MongoDB (local or MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/artisans-corner

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# URLs (no trailing slash). CLIENT_URL may be a comma separated allow-list.
CLIENT_URL=http://localhost:5273
SERVER_URL=http://localhost:5055

# Marketplace configuration
PLATFORM_COMMISSION_RATE=0.05
TAX_RATE=0.00
SHIPPING_FLAT_RATE=5
FREE_SHIPPING_THRESHOLD=75
CURRENCY=usd

# Cloudinary (product images). If left empty the server falls back to local
# disk storage in server/uploads (development convenience only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (test mode keys - sk_test_... / pk_test_... / whsec_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# DEV ONLY: allows checkout to complete without real Stripe keys.
# Must be false in production.
ALLOW_MOCK_PAYMENTS=true

# ---------- CLIENT (client/.env) ----------
VITE_API_URL=http://localhost:5055/api
VITE_STRIPE_PUBLISHABLE_KEY=
